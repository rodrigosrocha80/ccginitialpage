# Domínio público da aplicação
PUBLIC_SITE_URL=https://ccglocacao.com.br

# E-mail — Opção 1 (RECOMENDADA para Vercel/Serverless): Brevo API HTTP (porta 443, sem bloqueio de SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=naoresponder@ccglocacao.com.br
BREVO_SENDER_NAME="Site CCG Locações"

# Destinatários e remetente padrão
QUOTE_FROM_EMAIL="Site CCG Locações <naoresponder@ccglocacao.com.br>"
QUOTE_TO_EMAIL=contratos@ccglocacao.com.br
RH_TO_EMAIL=curriculos@ccglocacao.com.br

# E-mail — Opção 2 (Fallback SMTP opcional, usado apenas se BREVO_API_KEY estiver vazio)
SMTP_HOST=smtp.kinghost.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=naoresponder@ccglocacao.com.br
SMTP_PASS=

# Banco de dados PostgreSQL (KingHost ou outro servidor Postgres)
# Atenção: caracteres especiais na senha (como @) devem ser codificados na URL (%40)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
PGSSL=false
# Quando PGSSL=true, a validação do certificado TLS é ativada por padrão (defina false apenas se o provedor usar certificado autoassinado)
PGSSL_REJECT_UNAUTHORIZED=true

# Vercel Blob para upload direto de currículos de até 10 MB
# Crie uma Blob Store (recomendado: private) e conecte ao projeto na Vercel
# Na Vercel com OIDC (padrão atual): BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (injetados automaticamente)
# Alternativa legada: BLOB_READ_WRITE_TOKEN
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private

# Acesso ao Gestor de Vagas (/admin/vagas)
# FORTEMENTE RECOMENDADO em produção: definir senha forte e ADMIN_SESSION_SECRET aleatório e independente (ex.: openssl rand -hex 32)
ADMIN_USER=admin
ADMIN_PASSWORD=defina-uma-senha-forte-aqui
ADMIN_SESSION_SECRET=defina-uma-chave-aleatoria-longa-aqui

# Anti-spam Cloudflare Turnstile (FORTEMENTE RECOMENDADO em produção para formulários, upload de currículos e login admin)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit distribuído via Upstash Redis REST (recomendado em produção serverless; fallback em memória quando vazio)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Defina como true apenas se todo o tráfego passar obrigatoriamente por proxy Cloudflare bloqueando acesso direto à origem
TRUST_CLOUDFLARE_PROXY=false

# Analytics LGPD (carregados apenas após consentimento do usuário)
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

# Servidor Node (quando usado com @astrojs/node standalone)
HOST=0.0.0.0
PORT=4321
