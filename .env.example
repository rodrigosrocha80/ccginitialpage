# Domínio público da aplicação
PUBLIC_SITE_URL=https://ccglocacao.com.br

# E-mail (Resend) para recebimento de orçamentos em /api/orcamento
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUOTE_FROM_EMAIL="Site CCG Locações <noreply@ccglocacao.com.br>"
QUOTE_TO_EMAIL=contratos@ccglocacao.com.br

# Anti-spam Cloudflare Turnstile (opcional; se vazio, utiliza honeypot + rate limit em memória)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics LGPD (carregados apenas após consentimento do usuário)
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

# Servidor Node (quando usado com @astrojs/node standalone)
HOST=0.0.0.0
PORT=4321
