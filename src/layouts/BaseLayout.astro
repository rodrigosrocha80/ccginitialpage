---
import '@/styles/global.css';
import { getImage } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { ToastViewport } from '@/components/ToastViewport';
import { SITE } from '@/lib/site';
import { buildBreadcrumbSchema } from '@/lib/seo';
import heroDefault from '@/assets/hero/hero-obra-aerea.jpg';
import logoCcg from '@/assets/brand/logo-ccg.png';
import archivoLatinWoff2 from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogUrl?: string;
  ogImage?: string;
  breadcrumbs?: { label: string; href?: string }[];
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  ogUrl,
  ogImage,
  breadcrumbs,
  extraSchema = [],
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE.domain).toString();
const resolvedOgUrl = ogUrl ? new URL(ogUrl, SITE.domain).toString() : canonicalUrl;
const defaultOgImg = await getImage({ src: heroDefault, width: 1200, format: 'jpeg', quality: 80 });
const ogImageUrl = ogImage
  ? new URL(ogImage, SITE.domain).toString()
  : new URL(defaultOgImg.src, SITE.domain).toString();

const logoImg = await getImage({ src: logoCcg, width: 400, format: 'png' });
const logoUrl = new URL(logoImg.src, SITE.domain).toString();

const ga4Id = import.meta.env.PUBLIC_GA4_ID || '';
const clarityId = import.meta.env.PUBLIC_CLARITY_ID || '';

const graphNodes: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.domain}/#website`,
    name: SITE.brandShort,
    alternateName: 'CCG Construções e Locações',
    url: `${SITE.domain}/`,
    inLanguage: 'pt-BR',
    publisher: { '@id': `${SITE.domain}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.domain}/#organization`,
    name: SITE.legalName,
    alternateName: SITE.brandShort,
    url: `${SITE.domain}/`,
    logo: {
      '@type': 'ImageObject',
      url: logoUrl,
    },
    email: SITE.emailContratos,
    taxID: SITE.cnpj,
    foundingDate: '2003',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+55-98-3313-9550',
        contactType: 'sales',
        areaServed: 'BR',
        availableLanguage: 'Portuguese',
      },
      {
        '@type': 'ContactPoint',
        telephone: '+55-98-99988-0545',
        contactType: 'customer service',
        areaServed: 'BR',
        availableLanguage: 'Portuguese',
      },
    ],
    sameAs: [SITE.social.instagram, SITE.social.facebook, SITE.social.youtube],
  },
  {
    '@type': 'LocalBusiness',
    '@id': `${SITE.domain}/#localbusiness`,
    name: `${SITE.brandShort} — ${SITE.legalName}`,
    description:
      'Locação de máquinas pesadas, linha amarela, caminhões pesados e execução de obras de terraplenagem, drenagem e pavimentação em São Luís/MA, no Maranhão e em todo o Brasil.',
    url: `${SITE.domain}/`,
    image: ogImageUrl,
    logo: logoUrl,
    telephone: '+55-98-3313-9550',
    email: SITE.emailContratos,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.city,
      addressRegion: SITE.address.state,
      addressCountry: SITE.address.country,
    },
    areaServed: ['Maranhão', 'Pará', 'Rio Grande do Norte', 'Amapá', 'Ceará', 'Minas Gerais', 'Brasil'],
    knowsAbout: [
      'Locação de máquinas pesadas',
      'Locação de linha amarela',
      'Locação de caminhões pesados',
      'Escavadeira hidráulica',
      'Pá carregadeira',
      'Retroescavadeira',
      'Motoniveladora',
      'Rolo compactador',
      'Caminhão basculante',
      'Caminhão munck',
      'Carreta prancha',
      'Terraplenagem e pavimentação',
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Locação de Máquinas Pesadas, Linha Amarela e Caminhões',
      itemListElement: [
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Locação de Máquinas Pesadas e Linha Amarela',
            url: `${SITE.domain}/locacao-linha-amarela/`,
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Locação de Caminhões Pesados e Logística',
            url: `${SITE.domain}/locacao-de-caminhoes/`,
          },
        },
        {
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: 'Terraplenagem, Drenagem e Pavimentação Asfáltica',
            url: `${SITE.domain}/#servicos`,
          },
        },
      ],
    },
    parentOrganization: { '@id': `${SITE.domain}/#organization` },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  graphNodes.push(buildBreadcrumbSchema(breadcrumbs, canonicalPath));
}

for (const node of extraSchema) {
  graphNodes.push(node);
}

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatinWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedOgUrl} />
    <meta property="og:site_name" content={SITE.brandShort} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg).replace(/</g, '\\u003c')} />
  </head>
  <body class="flex min-h-screen flex-col antialiased selection:bg-ccg-yellow-400 selection:text-ink-primary">
    <a href="#conteudo-principal" class="sr-only sr-only-focusable">
      Pular para o conteúdo principal
    </a>

    <Header currentPath={Astro.url.pathname} />

    <main id="conteudo-principal" class="flex-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />
    <CookieConsent ga4Id={ga4Id} clarityId={clarityId} />
    <ToastViewport client:load />
  </body>
</html>
