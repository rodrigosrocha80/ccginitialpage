---
interface Props {
  id: 'procem' | 'iso-9001' | 'iso-14001';
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md';
}

const { id, variant = 'light', size = 'md' } = Astro.props;

const boxClass =
  size === 'sm' ? 'h-11 w-11 rounded-xl' : 'h-14 w-14 rounded-2xl';

const paletteClass =
  variant === 'dark'
    ? 'border border-ccg-yellow-400/35 bg-ccg-yellow-400/15 text-ccg-yellow-400'
    : 'border border-ccg-green-800/15 bg-ccg-green-50 text-ccg-green-800';
---

<span
  aria-hidden="true"
  class={`inline-flex shrink-0 items-center justify-center ${boxClass} ${paletteClass}`}
>
  {id === 'procem' && (
    <svg class={size === 'sm' ? 'h-5 w-5' : 'h-7 w-7'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2 4 5.5v6.2c0 5.1 3.4 9.7 8 10.8 4.6-1.1 8-5.7 8-10.8V5.5L12 2Z" />
      <path d="m9 12 2 2 4-4" />
    </svg>
  )}
  {id === 'iso-9001' && (
    <svg class={size === 'sm' ? 'h-5 w-5' : 'h-7 w-7'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="9" r="6" />
      <path d="m9.5 9 1.7 1.7L14.8 7" />
      <path d="M8.5 14.2 7 21l5-2.5L17 21l-1.5-6.8" />
    </svg>
  )}
  {id === 'iso-14001' && (
    <svg class={size === 'sm' ? 'h-5 w-5' : 'h-7 w-7'} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M11 20A7 7 0 0 1 4 13C4 7 10 3 20 3c0 10-4 16-9 17Z" />
      <path d="M4 20c3-4 6.5-7 11-9" />
    </svg>
  )}
</span>
