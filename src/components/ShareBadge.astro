---
import { buildShareLinks } from '@/lib/share';

interface Props {
  path: string;
  title: string;
  text: string;
  label?: string;
  ariaLabel?: string;
  variant?: 'overlay' | 'inline';
  align?: 'right' | 'left';
  class?: string;
}

const {
  path,
  title,
  text,
  label = 'Compartilhar',
  ariaLabel,
  variant = 'overlay',
  align = 'right',
  class: className = '',
} = Astro.props;

const defaultLinks = buildShareLinks({ path, title, text });

const triggerClasses =
  variant === 'overlay'
    ? 'rounded-full bg-white/95 px-2.5 py-1 text-xs font-semibold text-ccg-green-900 shadow-xs ring-1 ring-ccg-green-800/20 backdrop-blur-xs hover:bg-ccg-green-800 hover:text-white hover:ring-ccg-green-800'
    : 'rounded-full bg-ccg-green-50 px-2.5 py-1 text-xs font-semibold text-ccg-green-900 ring-1 ring-ccg-green-800/20 hover:bg-ccg-green-800 hover:text-white hover:ring-ccg-green-800';
---

<div
  class={`relative inline-flex ${className}`}
  data-share-badge
  data-share-path={path}
  data-share-title={title}
  data-share-text={text}
  data-share-label={label}
>
  <button
    type="button"
    data-share-trigger
    data-copied="false"
    title={ariaLabel || label}
    aria-label={ariaLabel || label}
    aria-haspopup="menu"
    aria-expanded="false"
    class={`inline-flex cursor-pointer items-center gap-1.5 whitespace-nowrap transition-colors data-[copied=true]:bg-ccg-green-800 data-[copied=true]:text-white data-[copied=true]:ring-ccg-green-800 ${triggerClasses}`}
  >
    <svg
      data-share-icon="share"
      aria-hidden="true"
      class="h-3.5 w-3.5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="18" cy="5" r="3" />
      <circle cx="6" cy="12" r="3" />
      <circle cx="18" cy="19" r="3" />
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
    </svg>
    <svg
      data-share-icon="check"
      aria-hidden="true"
      class="hidden h-3.5 w-3.5 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5" />
    </svg>
    <span data-share-text-label>{label}</span>
  </button>

  <div
    data-share-menu
    role="menu"
    aria-label={`Opções para compartilhar ${title}`}
    class={`hidden absolute top-full z-50 mt-1.5 w-52 rounded-xl border border-border-subtle bg-white p-1.5 text-left shadow-xl ring-1 ring-black/5 ${
      align === 'left' ? 'left-0' : 'right-0'
    }`}
  >
    <p class="px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-ink-muted">
      Compartilhar link
    </p>

    <button
      type="button"
      role="menuitem"
      data-share-action="copy"
      class="flex w-full cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs font-semibold text-ink-primary transition-colors hover:bg-ccg-green-50 hover:text-ccg-green-900"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4 shrink-0 text-ccg-green-800"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <span>Copiar link</span>
    </button>

    <a
      role="menuitem"
      data-share-action="whatsapp"
      href={defaultLinks.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs font-semibold text-ink-primary transition-colors hover:bg-ccg-green-50 hover:text-ccg-green-900"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4 shrink-0 text-[#128C7E]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M12.03 2a9.97 9.97 0 0 0-8.6 15.01L2 22l5.13-1.35A9.98 9.98 0 1 0 12.03 2Zm5.82 14.12c-.25.7-1.42 1.34-1.97 1.41-.51.07-1.15.1-1.85-.12-.43-.14-.99-.32-1.7-.63-2.99-1.29-4.94-4.32-5.09-4.52-.15-.2-1.21-1.61-1.21-3.07 0-1.46.76-2.18 1.03-2.48.27-.3.59-.37.79-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.33-.3.5-.15.18-.32.4-.45.53-.15.15-.31.31-.13.61.18.3.8 1.32 1.72 2.14 1.18 1.05 2.18 1.38 2.48 1.53.3.15.48.12.66-.07.18-.2.76-.88.96-1.18.2-.3.41-.25.69-.15.28.1 1.77.83 2.07.98.3.15.5.23.58.35.07.13.07.73-.18 1.43Z" />
      </svg>
      <span>WhatsApp</span>
    </a>

    <a
      role="menuitem"
      data-share-action="linkedin"
      href={defaultLinks.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs font-semibold text-ink-primary transition-colors hover:bg-ccg-green-50 hover:text-ccg-green-900"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4 shrink-0 text-[#0A66C2]"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
      </svg>
      <span>LinkedIn</span>
    </a>

    <a
      role="menuitem"
      data-share-action="email"
      href={defaultLinks.email}
      class="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs font-semibold text-ink-primary transition-colors hover:bg-ccg-green-50 hover:text-ccg-green-900"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4 shrink-0 text-ink-secondary"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
      <span>E-mail</span>
    </a>

    <button
      type="button"
      role="menuitem"
      data-share-action="native"
      class="hidden mt-1 w-full cursor-pointer items-center gap-2.5 border-t border-border-subtle px-2.5 pb-1.5 pt-2 text-xs font-semibold text-ccg-green-800 transition-colors hover:bg-ccg-green-50"
    >
      <svg
        aria-hidden="true"
        class="h-4 w-4 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
        <polyline points="16 6 12 2 8 6" />
        <line x1="12" y1="2" x2="12" y2="15" />
      </svg>
      <span>Mais opções...</span>
    </button>
  </div>
</div>

<script>
  import { buildShareLinks, copyTextToClipboard } from '@/lib/share';

  const SHARE_OPEN_EVENT = 'ccg:share-menu-open';
  const INIT_FLAG = '__ccgShareBadgeInitialized';

  if (!(window as unknown as Record<string, boolean>)[INIT_FLAG]) {
    (window as unknown as Record<string, boolean>)[INIT_FLAG] = true;

    const closeAll = (exceptRoot?: HTMLElement | null) => {
      document.querySelectorAll<HTMLElement>('[data-share-badge]').forEach((root) => {
        if (exceptRoot && root === exceptRoot) return;
        const trigger = root.querySelector<HTMLButtonElement>('[data-share-trigger]');
        const menu = root.querySelector<HTMLElement>('[data-share-menu]');
        trigger?.setAttribute('aria-expanded', 'false');
        menu?.classList.add('hidden');
      });
    };

    const showCopiedState = (root: HTMLElement) => {
      const trigger = root.querySelector<HTMLButtonElement>('[data-share-trigger]');
      const labelEl = root.querySelector<HTMLElement>('[data-share-text-label]');
      const shareIcon = root.querySelector<SVGElement>('[data-share-icon="share"]');
      const checkIcon = root.querySelector<SVGElement>('[data-share-icon="check"]');
      if (!trigger || !labelEl) return;

      const defaultLabel = root.dataset.shareLabel || 'Compartilhar';
      labelEl.textContent = 'Link copiado!';
      shareIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      trigger.dataset.copied = 'true';

      const prevTimer = Number(root.dataset.copiedTimer || 0);
      if (prevTimer) window.clearTimeout(prevTimer);

      const timer = window.setTimeout(() => {
        labelEl.textContent = defaultLabel;
        shareIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        trigger.dataset.copied = 'false';
      }, 2400);

      root.dataset.copiedTimer = String(timer);
    };

    const syncLinksForOrigin = (root: HTMLElement) => {
      const path = root.dataset.sharePath || '/';
      const title = root.dataset.shareTitle || document.title;
      const text = root.dataset.shareText || '';
      const links = buildShareLinks({ path, title, text });

      const wa = root.querySelector<HTMLAnchorElement>('[data-share-action="whatsapp"]');
      const li = root.querySelector<HTMLAnchorElement>('[data-share-action="linkedin"]');
      const em = root.querySelector<HTMLAnchorElement>('[data-share-action="email"]');
      const nativeBtn = root.querySelector<HTMLButtonElement>('[data-share-action="native"]');

      if (wa) wa.href = links.whatsapp;
      if (li) li.href = links.linkedin;
      if (em) em.href = links.email;
      if (nativeBtn && typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
        nativeBtn.classList.remove('hidden');
        nativeBtn.classList.add('flex');
      }

      return { links, title, text };
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const trigger = target.closest<HTMLButtonElement>('[data-share-trigger]');
      if (trigger) {
        const root = trigger.closest<HTMLElement>('[data-share-badge]');
        if (!root) return;
        event.preventDefault();
        event.stopPropagation();

        const menu = root.querySelector<HTMLElement>('[data-share-menu]');
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';

        closeAll(root);

        if (isOpen) {
          trigger.setAttribute('aria-expanded', 'false');
          menu?.classList.add('hidden');
        } else {
          syncLinksForOrigin(root);
          window.dispatchEvent(new CustomEvent(SHARE_OPEN_EVENT, { detail: { id: 'astro' } }));
          trigger.setAttribute('aria-expanded', 'true');
          menu?.classList.remove('hidden');
        }
        return;
      }

      const actionEl = target.closest<HTMLElement>('[data-share-action]');
      if (actionEl) {
        const root = actionEl.closest<HTMLElement>('[data-share-badge]');
        if (!root) return;
        const action = actionEl.dataset.shareAction;
        const { links, title, text } = syncLinksForOrigin(root);

        if (action === 'copy') {
          event.preventDefault();
          event.stopPropagation();
          void copyTextToClipboard(links.url).then((ok) => {
            if (ok) showCopiedState(root);
          });
          closeAll();
          return;
        }

        if (action === 'native') {
          event.preventDefault();
          event.stopPropagation();
          closeAll();
          if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
            navigator
              .share({ title, text, url: links.url })
              .catch((err) => {
                if (err instanceof DOMException && err.name === 'AbortError') return;
                void copyTextToClipboard(links.url).then((ok) => {
                  if (ok) showCopiedState(root);
                });
              });
          }
          return;
        }

        closeAll();
        return;
      }

      if (!target.closest('[data-share-badge]')) {
        closeAll();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openTrigger = document.querySelector<HTMLButtonElement>(
        '[data-share-trigger][aria-expanded="true"]'
      );
      if (openTrigger) {
        closeAll();
        openTrigger.focus();
      }
    });

    window.addEventListener(SHARE_OPEN_EVENT, (event) => {
      const detail = (event as CustomEvent<{ id?: string }>).detail;
      if (detail?.id !== 'astro') {
        closeAll();
      }
    });
  }
</script>
