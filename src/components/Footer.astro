---
import { Image } from 'astro:assets';
import logoCcg from '@/assets/brand/logo-ccg.png';
import { SITE, buildWhatsAppUrl } from '@/lib/site';
---

<footer class="border-t border-ccg-green-900/40 bg-ccg-forest text-emerald-50">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <!-- Identidade + CNPJ + Redes -->
      <div class="space-y-4 lg:col-span-4">
        <div class="inline-flex rounded-xl bg-white p-2.5 shadow-sm">
          <Image
            src={logoCcg}
            alt="CCG Construções e Terraplenagem"
            width={140}
            height={72}
            class="h-12 w-auto object-contain"
          />
        </div>
        <p class="text-sm leading-relaxed text-emerald-100/85">
          <strong class="text-white">{SITE.legalName}</strong>. Desde {SITE.foundedYear}, entregando
          locação de máquinas pesadas, linha amarela, terraplenagem e obras de infraestrutura com
          segurança, qualidade e alta disponibilidade operacional.
        </p>
        <p class="text-xs font-medium text-emerald-200/80">
          CNPJ: {SITE.cnpj}
        </p>

        <div class="flex items-center gap-3 pt-1">
          <a
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram da CCG Construções"
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-white/15 bg-white/5 text-white transition-colors hover:border-ccg-yellow-400 hover:text-ccg-yellow-400"
          >
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
            </svg>
          </a>
          <a
            href={SITE.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook da CCG Construções"
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-white/15 bg-white/5 text-white transition-colors hover:border-ccg-yellow-400 hover:text-ccg-yellow-400"
          >
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.9.3-1.5 1.5-1.5h1.7V4.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.2V11H7.5v3h2.8v8h3.2Z" />
            </svg>
          </a>
          <a
            href={SITE.social.youtube}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube da CCG Construções"
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-white/15 bg-white/5 text-white transition-colors hover:border-ccg-yellow-400 hover:text-ccg-yellow-400"
          >
            <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21.6 7.2a2.7 2.7 0 0 0-1.9-1.9C18 4.8 12 4.8 12 4.8s-6 0-7.7.5A2.7 2.7 0 0 0 2.4 7.2 28.5 28.5 0 0 0 2 12a28.5 28.5 0 0 0 .4 4.8 2.7 2.7 0 0 0 1.9 1.9c1.7.5 7.7.5 7.7.5s6 0 7.7-.5a2.7 2.7 0 0 0 1.9-1.9A28.5 28.5 0 0 0 22 12a28.5 28.5 0 0 0-.4-4.8ZM10 15.2V8.8L15.6 12 10 15.2Z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Mapa do site -->
      <div class="space-y-3 lg:col-span-2">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-ccg-yellow-400">
          Navegação
        </h3>
        <ul class="space-y-0.5 text-sm text-emerald-100/85">
          <li><a href="/" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Início</a></li>
          <li><a href="/locacao-linha-amarela" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Locação Linha Amarela</a></li>
          <li><a href="/locacao-de-caminhoes" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Locação de Caminhões</a></li>
          <li><a href="/equipamentos" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Equipamentos</a></li>
          <li><a href="/obras" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Obras Realizadas</a></li>
          <li><a href="/clientes" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Clientes e Parceiros</a></li>
          <li><a href="/sobre" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">A CCG</a></li>
          <li><a href="/politica-integrada" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Política Integrada (SGI)</a></li>
          <li><a href="/trabalhe-conosco" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Trabalhe Conosco</a></li>
          <li><a href="/contato" class="inline-flex min-h-[32px] items-center hover:text-white hover:underline">Contatos</a></li>
        </ul>
      </div>

      <!-- Contatos -->
      <div class="space-y-3 lg:col-span-3">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-ccg-yellow-400">
          Central de Atendimento
        </h3>
        <ul class="space-y-3 text-sm text-emerald-100/90">
          <li>
            <span class="block text-xs text-emerald-200/70">Telefone fixo</span>
            <a href={SITE.phoneLandlineHref} class="inline-flex min-h-[32px] items-center font-semibold text-white hover:text-ccg-yellow-400">
              {SITE.phoneLandline}
            </a>
          </li>
          <li>
            <span class="block text-xs text-emerald-200/70">WhatsApp e Comercial</span>
            <div class="flex flex-col items-start gap-1">
              <a
                href={buildWhatsAppUrl()}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[32px] items-center font-semibold text-white hover:text-ccg-yellow-400"
              >
                {SITE.whatsappPrimary.display}
              </a>
              <a
                href={`https://wa.me/${SITE.whatsappSecondary.e164}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[32px] items-center font-semibold text-white hover:text-ccg-yellow-400"
              >
                {SITE.whatsappSecondary.display}
              </a>
            </div>
          </li>
          <li>
            <span class="block text-xs text-emerald-200/70">E-mails oficiais</span>
            <div class="flex flex-col items-start gap-1">
              <a href={`mailto:${SITE.emailContratos}`} class="inline-flex min-h-[32px] items-center hover:text-ccg-yellow-400">
                {SITE.emailContratos}
              </a>
              <a href={`mailto:${SITE.emailCurriculos}`} class="inline-flex min-h-[32px] items-center hover:text-ccg-yellow-400">
                {SITE.emailCurriculos}
              </a>
            </div>
          </li>
          <li>
            <span class="block text-xs text-emerald-200/70">Matriz / Pátio</span>
            <p class="text-xs leading-relaxed text-emerald-100/90">{SITE.address.full}</p>
          </li>
        </ul>
      </div>

      <!-- Mapa -->
      <div class="space-y-3 lg:col-span-3">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-ccg-yellow-400">
          Localização — Pedrinhas
        </h3>
        <div class="overflow-hidden rounded-xl border border-white/15 bg-ccg-green-900">
          <iframe
            title="Mapa de localização da sede CCG Construções em Pedrinhas, São Luís - MA"
            src={SITE.address.mapsEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-44 w-full border-0"
          ></iframe>
        </div>
        <a
          href={SITE.address.mapsQueryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-ccg-yellow-400 hover:underline"
        >
          Abrir rota no Google Maps
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-xs text-emerald-200/75 sm:flex-row sm:items-center">
      <p>
        &copy; {new Date().getFullYear()} {SITE.legalName} &bull; CNPJ {SITE.cnpj} &bull; Todos os direitos reservados.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/privacidade" class="hover:text-white hover:underline">
          Política de Privacidade (LGPD)
        </a>
        <button
          id="ccg-open-cookie-btn"
          type="button"
          class="cursor-pointer hover:text-white hover:underline"
        >
          Gerenciar Cookies
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('ccg-open-cookie-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('ccg:open-cookie-consent'));
  });
</script>
